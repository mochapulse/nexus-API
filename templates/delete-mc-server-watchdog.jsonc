// REAL RESPONSE EXAMPLE — DELETE /api/v1/mc-server/watchdog
// DEBUG=true  : this exact payload is returned (stub); STATE is never touched.
// Production  : watchdog.disarm(STATE, "manual") then the live snapshot()
//               payload. Idempotent — calling it while already disarmed
//               just re-records "manual" and returns the same shape.
// last_disarm_reason values: null | "manual" | "expired" | "mc_unrecoverable" |
//   "poweroff_failed" (systemctl poweroff itself failed, e.g. missing polkit rule)
{
  "armed": false,
  "deadline": null,
  "remaining_seconds": 0,
  "threshold_seconds": 1800,
  "empty_seconds": null,
  "players_online": null,
  "players_max": null,
  "mc_version": null,
  "mc_motd": null,
  "mc_latency_ms": null,
  "mc_reachable": false,
  "restarts_used": 0,
  "max_restarts": 3,
  "last_disarm_reason": "manual"
}
